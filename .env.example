# ── Required ──────────────────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ── Throughput Tuning ─────────────────────────────────────────────────────────
# Number of images to pack into a single Gemini API request.
# Start at 3 for accuracy verification. Raise to 6 only after spot-checking
# that field attribution is correct across multi-image batches.
GEMINI_BATCH_SIZE=3

# Gemini free tier allows 15 RPM. Adjust only if you upgrade to a paid plan.
GEMINI_RPM=15

# Gemini model to use. gemini-1.5-flash is the correct free-tier model (15 RPM).
# gemini-1.5-pro is rate-limited to 2 RPM on the free tier — do NOT use at scale.
GEMINI_MODEL=gemini-1.5-flash
